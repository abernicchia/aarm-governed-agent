# Copy to .env for local runs (azd ai agent run also sets these automatically).

# Required for FoundryChatClient
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Suppress OpenTelemetry console JSON dumps during local runs.
# Without Azure Monitor connected locally, the distro auto-enables console
# export and prints noisy trace/metric JSON (including harmless IMDS errors).
OTEL_METRICS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Optional: auto-approve STEP_UP tool calls during local demos (read at agent startup).
# GOVERNANCE_AUTO_APPROVE=1

# Optional: lower rogue-detection thresholds for Scenario 7 script (default: enabled).
# Set to 0 for production-like stock AGT thresholds.
# GOVERNANCE_ROGUE_DEMO=1

# Optional: used by azd deploy
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
